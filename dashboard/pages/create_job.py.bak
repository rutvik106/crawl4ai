    col1, col2, col3 = st.columns([1, 2, 1])

    if col1.button("← Back", use_container_width=True):
        st.session_state.wizard_step = 4
        st.rerun()

    if col3.button("🚀 Create & Run", use_container_width=True, type="primary"):
